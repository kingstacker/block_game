<UserControl x:Class="BlockGame.Uninstall.TransientPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <PasswordBox x:Name="MaskedPasswordBox"
                     Padding="10,8,50,8"
                     PasswordChanged="MaskedPasswordBox_PasswordChanged" />

        <Border x:Name="PlainPasswordSurface"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False">
            <TextBlock x:Name="PlainPasswordText"
                       Margin="10,0,50,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Button x:Name="RevealButton"
                Width="42"
                Margin="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Focusable="False"
                FocusVisualStyle="{x:Null}"
                ToolTip="按住显示密码"
                PreviewMouseLeftButtonDown="RevealButton_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="RevealButton_PreviewMouseLeftButtonUp"
                LostMouseCapture="RevealButton_LostMouseCapture"
                MouseLeave="RevealButton_MouseLeave">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RevealSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0,6,6,0"
                            SnapsToDevicePixels="True">
                        <Grid Width="20"
                              Height="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path x:Name="ClosedEyeIcon"
                                  Data="M1.5,8 C3.8,4.1 6.7,2.2 10,2.2 C13.3,2.2 16.2,4.1 18.5,8 C16.2,11.9 13.3,13.8 10,13.8 C6.7,13.8 3.8,11.9 1.5,8 M2.5,1.8 L17.5,14.2"
                                  Fill="Transparent"
                                  Stroke="#1D4ED8"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Grid x:Name="OpenEyeIcon" Visibility="Collapsed">
                                <Path Data="M1.5,8 C3.8,4.1 6.7,2.2 10,2.2 C13.3,2.2 16.2,4.1 18.5,8 C16.2,11.9 13.3,13.8 10,13.8 C6.7,13.8 3.8,11.9 1.5,8 Z"
                                      Fill="Transparent"
                                      Stroke="#1D4ED8"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round" />
                                <Ellipse Width="5"
                                         Height="5"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="#1D4ED8" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Revealed">
                            <Setter TargetName="ClosedEyeIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OpenEyeIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RevealSurface" Property="Background" Value="#EFF6FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RevealSurface" Property="Background" Value="#DBEAFE" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RevealSurface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
