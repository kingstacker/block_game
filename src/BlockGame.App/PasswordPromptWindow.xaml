<Window x:Class="BlockGame.App.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验证管理密码"
        Width="420"
        Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="需要管理密码" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="ActionDescriptionText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="管理密码" Margin="0,0,0,6" />
            <PasswordBox x:Name="InputPasswordBox" KeyDown="InputPasswordBox_KeyDown" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="CancelButton_Click" />
            <Button Style="{StaticResource PrimaryButton}" Margin="0" Content="确认" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
