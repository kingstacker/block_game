<Window x:Class="BlockGame.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlockGame.App"
        Title="BlockGame 游戏自律助手"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="680"
        Icon="Assets/BlockGame.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="22" Background="Transparent" BorderThickness="0">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,18,4,0">
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="拦截状态" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ProtectionStatusText" Text="—" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="当前模式" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ModeStatusText" Text="—" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="设置锁" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="LockStatusText" Text="—" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="已启用规则" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="RuleCountText" Text="0" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="屏蔽模式与解除" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,8,12,0"
                                               Text="屏蔽模式"
                                               Foreground="{StaticResource TextBrush}" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="ProtectionModeComboBox"
                                              SelectionChanged="ProtectionModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="严格模式（默认）" Tag="Strict" />
                                        <ComboBoxItem Content="协商模式" Tag="Negotiation" />
                                        <ComboBoxItem Content="预览屏蔽模式" Tag="Preview" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2"
                                               x:Name="ModeDescriptionText"
                                               Margin="16,5,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                                <TextBlock x:Name="UnlockStatusText" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                <WrapPanel>
                                    <Button x:Name="EnableLockButton" Style="{StaticResource PrimaryButton}" Content="启用并锁定严格保护" Click="EnableLockButton_Click" />
                                    <Button x:Name="EnablePreviewButton" Style="{StaticResource PrimaryButton}" Content="启用预览屏蔽" Click="EnablePreviewButton_Click" Visibility="Collapsed" />
                                    <Button x:Name="RequestUnlockButton" Style="{StaticResource SecondaryButton}" Content="申请解除" Click="RequestUnlockButton_Click" />
                                    <Button x:Name="CompleteUnlockButton" Style="{StaticResource SecondaryButton}" Content="完成解除" Click="CompleteUnlockButton_Click" />
                                    <Button x:Name="DisableProtectionButton" Style="{StaticResource DangerButton}" Content="暂停拦截" Click="DisableProtectionButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="累计已拦截" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="BlockedCountText"
                                               Text="0 次"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EAECF0" />
                                <StackPanel Grid.Column="2" Margin="20,0,0,0">
                                    <TextBlock Text="最近拦截内容"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="RecentBlockedContentText"
                                               Margin="0,8,0,0"
                                               Text="暂无拦截记录"
                                               TextWrapping="Wrap"
                                               LineHeight="23"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="拦截规则">
                <Grid Margin="4,18,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="规则名称"
                                               Margin="0,0,0,6"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="RuleNameTextBox" MinHeight="38" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="匹配方式"
                                               Margin="0,0,0,6"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="RuleTargetComboBox"
                                              Height="38"
                                              SelectedIndex="0"
                                              SelectionChanged="RuleTargetComboBox_SelectionChanged">
                                        <ComboBoxItem Content="程序文件名" Tag="FileName" />
                                        <ComboBoxItem Content="完整路径" Tag="FullPath" />
                                        <ComboBoxItem Content="网站域名" Tag="Domain" />
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="BrowseExeButton"
                                        Grid.Column="2"
                                        Height="38"
                                        MinWidth="100"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="选择 EXE"
                                        Click="BrowseExeButton_Click" />
                                <Button Grid.Column="3"
                                        Height="38"
                                        MinWidth="100"
                                        Margin="0"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="添加规则"
                                        Click="AddRuleButton_Click" />
                            </Grid>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock x:Name="RulePatternHelpText"
                                           Text="匹配文件名、内部产品名或文件描述（支持 * 和 ?，自动补 .exe）"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="RulePatternTextBox"
                                         Height="72"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <Border x:Name="ShortcutDropZone"
                                    Margin="0,14,0,0"
                                    MinHeight="58"
                                    Padding="14,9"
                                    CornerRadius="8"
                                    Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               x:Name="ShortcutDropHelpText"
                                               Text="将桌面或开始菜单中的 .lnk 快捷方式拖到这里，或点击右侧按钮选择文件。"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentTextBrush}" />
                                    <Button Grid.Column="1"
                                            MinWidth="126"
                                            Height="38"
                                            Margin="16,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Background="White"
                                            BorderBrush="{StaticResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            Content="选择快捷方式"
                                            Click="BrowseShortcutButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="RulesDataGrid"
                              SelectionMode="Single"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              PreviewMouseRightButtonDown="RulesDataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="修改规则" Click="EditRuleMenuItem_Click" />
                                <MenuItem Header="临时放行软件…" Click="GrantTemporaryReleaseButton_Click" />
                                <MenuItem Header="立即收回临时放行" Click="RevokeTemporaryReleaseButton_Click" />
                                <Separator />
                                <MenuItem Header="删除规则" Click="DeleteRuleButton_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="勾选启用，取消勾选停用"
                                                  Click="RuleEnabledCheckBox_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TargetDisplay}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="匹配内容" Binding="{Binding Pattern}" Width="2.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="临时放行" Binding="{Binding TemporaryReleaseDisplay}" Width="170" IsReadOnly="True" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedDisplay}" Width="150" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="导入规则" Click="ImportRulesButton_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="导出规则" Click="ExportRulesButton_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="临时放行选中软件" Click="GrantTemporaryReleaseButton_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="收回临时放行" Click="RevokeTemporaryReleaseButton_Click" />
                        <Button Style="{StaticResource DangerButton}" Content="删除选中规则" Click="DeleteRuleButton_Click" />
                        <TextBlock Margin="8,9,0,0" Foreground="{StaticResource MutedTextBrush}" Text="锁定期间不能修改规则；协商模式仍可为软件规则临时放行。" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="审计日志">
                <Grid Margin="4,18,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最近 300 条记录" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="导出日志" Click="ExportLogsButton_Click" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="0" Content="刷新" Click="RefreshLogsButton_Click" />
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="AuditDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeDisplay}" Width="165" />
                            <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="160" />
                            <DataGridTextColumn Header="结果" Binding="{Binding ResultDisplay}" Width="80" />
                            <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,18,4,0">
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="冷静期" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="锁定期间只能延长，不能缩短；1 月按 30 天计算，最长 12 个月。" Margin="0,4,0,12" Foreground="{StaticResource MutedTextBrush}" />
                                <DockPanel LastChildFill="False">
                                    <TextBox x:Name="UnlockDelayValueTextBox" Width="120" />
                                    <ComboBox x:Name="UnlockDelayUnitComboBox"
                                              Width="90"
                                              Margin="9,0,18,0"
                                              SelectedIndex="0"
                                              SelectionChanged="UnlockDelayUnitComboBox_SelectionChanged">
                                        <ComboBoxItem Content="小时" Tag="Hours" />
                                        <ComboBoxItem Content="天" Tag="Days" />
                                        <ComboBoxItem Content="月" Tag="Months" />
                                    </ComboBox>
                                    <Button Style="{StaticResource SecondaryButton}" Content="保存冷静期" Click="SaveDelayButton_Click" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="修改管理密码" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="管理界面已通过访问验证；必须先完成解除流程，才能修改密码。" Margin="0,4,0,12" Foreground="{StaticResource MutedTextBrush}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="新密码" Margin="0,0,0,5" />
                                        <local:TransientPasswordBox x:Name="NewPasswordBox" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="确认新密码" Margin="0,0,0,5" />
                                        <local:TransientPasswordBox x:Name="ConfirmNewPasswordBox" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button Width="130" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource SecondaryButton}" Content="修改密码" Click="ChangePasswordButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="恢复默认设置" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="保留管理密码；恢复默认严格模式并暂停拦截，将冷静期重置为 24 小时，删除自定义规则，并恢复未启用的默认规则。设置锁定期间不能执行。"
                                           Margin="0,4,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <Button Width="150"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource DangerButton}"
                                        Content="恢复默认设置"
                                        Click="RestoreDefaultsButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="卸载软件" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="独立卸载程序会再次验证管理密码；保护处于锁定状态时，必须先完成解除流程。" Margin="0,4,0,12" Foreground="{StaticResource MutedTextBrush}" />
                                <Button Width="150" HorizontalAlignment="Left" Style="{StaticResource DangerButton}" Content="卸载 BlockGame" Click="OpenUninstallerButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="关于 BlockGame"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Margin="0,0,0,9"
                                               Text="开发者"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Margin="0,0,0,9"
                                               Text="kingstacker"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="联系方式"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="kingstacker_work@163.com"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentTextBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DataDirectoryText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource FooterBackground}" Padding="22,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="BlockGame v0.1.2 · 本工具提供自我约束阻力，但本机管理员仍拥有最终系统恢复能力。"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Border Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="#DCEBFC"
                        CornerRadius="6">
                    <TextBlock x:Name="HeaderGuardStatusText"
                               Text="正在检查守护程序…"
                               FontSize="12"
                               Foreground="{StaticResource AccentTextBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
