<Window x:Class="BlockGame.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockGame 游戏自律助手"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="680"
        Icon="Assets/BlockGame.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1D4ED8" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BlockGame" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="把临时冲动变成需要等待的决定" Margin="0,4,0,0" Foreground="#DCE7FF" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,12,0"
                        Padding="16,8"
                        Background="#D92D20"
                        BorderBrush="#F97066"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Content="调试一键复位"
                        ToolTip="最高优先级：立即暂停拦截、解除锁定并删除全部规则，不校验密码"
                        Click="DebugResetButton_Click" />
                <Border Grid.Column="2" Background="#1E40AF" CornerRadius="2" Padding="14,7" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderGuardStatusText" Text="正在检查守护程序…" Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="22" Background="Transparent" BorderThickness="0">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,18,4,0">
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="拦截状态" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="ProtectionStatusText" Text="—" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Text="设置锁" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="LockStatusText" Text="—" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="已启用规则" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="RuleCountText" Text="0" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="解除状态" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="UnlockStatusText" Margin="0,9,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                <WrapPanel>
                                    <Button x:Name="EnableLockButton" Style="{StaticResource PrimaryButton}" Content="启用并锁定保护" Click="EnableLockButton_Click" />
                                    <Button x:Name="RequestUnlockButton" Style="{StaticResource SecondaryButton}" Content="申请解除" Click="RequestUnlockButton_Click" />
                                    <Button x:Name="CompleteUnlockButton" Style="{StaticResource SecondaryButton}" Content="完成解除" Click="CompleteUnlockButton_Click" />
                                    <Button x:Name="DisableProtectionButton" Style="{StaticResource DangerButton}" Content="暂停拦截" Click="DisableProtectionButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="累计已拦截" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="BlockedCountText"
                                               Text="0 次"
                                               Margin="0,8,0,0"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#EAECF0" />
                                <StackPanel Grid.Column="2" Margin="20,0,0,0">
                                    <TextBlock Text="最近拦截内容"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="RecentBlockedContentText"
                                               Margin="0,8,0,0"
                                               Text="暂无拦截记录"
                                               TextWrapping="Wrap"
                                               LineHeight="23"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="拦截规则">
                <Grid Margin="4,18,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="规则名称" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="RuleNameTextBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="匹配方式" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <ComboBox x:Name="RuleTargetComboBox"
                                          SelectedIndex="0"
                                          SelectionChanged="RuleTargetComboBox_SelectionChanged">
                                    <ComboBoxItem Content="程序文件名" Tag="FileName" />
                                    <ComboBoxItem Content="完整路径" Tag="FullPath" />
                                    <ComboBoxItem Content="网站域名" Tag="Domain" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock x:Name="RulePatternHelpText"
                                           Text="匹配文件名、内部产品名或文件描述（支持 * 和 ?，自动补 .exe）"
                                           Margin="0,0,0,5"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="RulePatternTextBox"
                                         Height="88"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <Button x:Name="BrowseExeButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="选择 EXE" VerticalAlignment="Bottom" Click="BrowseExeButton_Click" />
                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="添加规则" VerticalAlignment="Bottom" Margin="0" Click="AddRuleButton_Click" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="RulesDataGrid"
                              SelectionMode="Single"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              PreviewMouseRightButtonDown="RulesDataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="修改规则" Click="EditRuleMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="删除规则" Click="DeleteRuleButton_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="勾选启用，取消勾选停用"
                                                  Click="RuleEnabledCheckBox_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TargetDisplay}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="匹配内容" Binding="{Binding Pattern}" Width="2.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedDisplay}" Width="150" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="导入规则" Click="ImportRulesButton_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Content="导出规则" Click="ExportRulesButton_Click" />
                        <Button Style="{StaticResource DangerButton}" Content="删除选中规则" Click="DeleteRuleButton_Click" />
                        <TextBlock Margin="8,9,0,0" Foreground="{StaticResource MutedTextBrush}" Text="导入会跳过重复规则；锁定期间不能导入、修改、停用或删除。" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="审计日志">
                <Grid Margin="4,18,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="最近 300 条记录" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Margin="0" Content="刷新" Click="RefreshLogsButton_Click" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="AuditDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeDisplay}" Width="165" />
                            <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="160" />
                            <DataGridTextColumn Header="结果" Binding="{Binding ResultDisplay}" Width="80" />
                            <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,18,4,0">
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="冷静期" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="锁定期间只能延长，不能缩短；1 月按 30 天计算，最长 12 个月。" Margin="0,4,0,12" Foreground="{StaticResource MutedTextBrush}" />
                                <DockPanel LastChildFill="False">
                                    <TextBox x:Name="UnlockDelayValueTextBox" Width="120" />
                                    <ComboBox x:Name="UnlockDelayUnitComboBox"
                                              Width="90"
                                              Margin="9,0,18,0"
                                              SelectedIndex="0"
                                              SelectionChanged="UnlockDelayUnitComboBox_SelectionChanged">
                                        <ComboBoxItem Content="小时" Tag="Hours" />
                                        <ComboBoxItem Content="天" Tag="Days" />
                                        <ComboBoxItem Content="月" Tag="Months" />
                                    </ComboBox>
                                    <Button Style="{StaticResource SecondaryButton}" Content="保存冷静期" Click="SaveDelayButton_Click" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="修改管理密码" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="管理界面已通过访问验证；必须先完成解除流程，才能修改密码。" Margin="0,4,0,12" Foreground="{StaticResource MutedTextBrush}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="新密码" Margin="0,0,0,5" />
                                        <PasswordBox x:Name="NewPasswordBox" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="确认新密码" Margin="0,0,0,5" />
                                        <PasswordBox x:Name="ConfirmNewPasswordBox" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button Width="130" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource SecondaryButton}" Content="修改密码" Click="ChangePasswordButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="卸载软件" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="独立卸载程序会再次验证管理密码；保护处于锁定状态时，必须先完成解除流程。" Margin="0,4,0,12" Foreground="{StaticResource MutedTextBrush}" />
                                <Button Width="150" HorizontalAlignment="Left" Style="{StaticResource DangerButton}" Content="卸载 BlockGame" Click="OpenUninstallerButton_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DataDirectoryText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#EAF0FF" Padding="22,9">
            <TextBlock Text="BlockGame v0.1 · 本工具提供自我约束阻力，但本机管理员仍拥有最终系统恢复能力。" Foreground="#667085" />
        </Border>
    </Grid>
</Window>
