<Window x:Class="BlockGame.App.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次设置 BlockGame"
        Width="480"
        Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="设置管理密码" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Margin="0,7,0,0" Text="密码用于规则修改、解除和卸载。请不要使用日常账户密码。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="管理密码（至少 8 个字符）" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox" />
            <TextBlock Text="再次输入" Margin="0,16,0,6" />
            <PasswordBox x:Name="ConfirmPasswordBox" />
            <TextBlock Text="默认解除冷静期（小时）" Margin="0,16,0,6" />
            <TextBox x:Name="DelayHoursTextBox" Text="24" />
            <TextBlock Margin="0,12,0,0" Text="建议让可信任的人保管密码。即使你保留管理员权限，这仍然是增加绕过成本，而不是绝对不可移除。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="退出" Click="CancelButton_Click" />
            <Button Style="{StaticResource PrimaryButton}" Margin="0" Content="保存并进入" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
