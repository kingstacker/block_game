<Window x:Class="BlockGame.App.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次设置 BlockGame"
        Width="480"
        MinHeight="540"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="设置管理密码" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Margin="0,7,0,0" Text="密码用于规则修改、解除和卸载。请不要使用日常账户密码。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,22,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="管理密码（至少 8 个字符）" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox" />
                <TextBlock Text="再次输入" Margin="0,16,0,6" />
                <PasswordBox x:Name="ConfirmPasswordBox" />
                <TextBlock Text="默认解除冷静期（小时，最长 12 个月）" Margin="0,16,0,6" />
                <TextBox x:Name="DelayHoursTextBox" Text="24" />
                <TextBlock Margin="0,12,0,0"
                           Text="默认使用严格模式；你可以先在主界面切换到预览屏蔽模式测试规则。严格模式启用并锁定后，必须等待冷静期结束才能切换模式。"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Margin="0,10,0,0"
                           Text="建议让可信任的人保管密码。即使你保留管理员权限，这仍然是增加绕过成本，而不是绝对不可移除。"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,22,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="退出" Click="CancelButton_Click" />
            <Button Style="{StaticResource PrimaryButton}" Margin="0" Content="保存并进入" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
