<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BlockGame.Core\BlockGame.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The process is WPF; WinForms is referenced only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BlockGame.ico</ApplicationIcon>
    <AssemblyName>BlockGame.App</AssemblyName>
    <RootNamespace>BlockGame.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\BlockGame.ico" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
